# R17: a nested dashboard promoted to ACC on its own (its parent stays in DEV).
@prefix adp: <https://example.org/acme/data-platform#> .

adp:svcStorage a adp:PlatformService ; adp:serviceOwnedBy adp:storageTeam .
adp:storageTeam a adp:PlatformTeam .
adp:salesTeam a adp:ProductTeam .
adp:salesApp a adp:AIAnalyticalApplication ; adp:createdBy adp:salesTeam ; adp:resourceOwnedBy adp:salesTeam ;
    adp:createdWith adp:svcStorage ; adp:createdIn adp:DEV .
adp:salesDash a adp:Dashboard, adp:SubPlatformResource ; adp:belongsTo adp:salesApp ; adp:createdBy adp:salesTeam ;
    adp:resourceOwnedBy adp:salesTeam ; adp:createdWith adp:svcStorage ; adp:promotedTo adp:ACC .
