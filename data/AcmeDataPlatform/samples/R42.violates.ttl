# R42: a dashboard consuming another dashboard.
@prefix adp: <https://example.org/acme/data-platform#> .

adp:svcStorage a adp:PlatformService ; adp:serviceOwnedBy adp:storageTeam .
adp:storageTeam a adp:PlatformTeam .
adp:salesTeam a adp:ProductTeam .
adp:hrTeam a adp:ProductTeam .
adp:orderManagement a adp:DataSource .
adp:kpiDash a adp:Dashboard ; adp:createdBy adp:salesTeam ; adp:resourceOwnedBy adp:salesTeam ; adp:createdWith adp:svcStorage ; adp:createdIn adp:DEV .
adp:hrDashboard a adp:Dashboard ; adp:createdBy adp:hrTeam ; adp:resourceOwnedBy adp:hrTeam ; adp:createdWith adp:svcStorage ; adp:createdIn adp:DEV ; adp:consumes adp:kpiDash .
