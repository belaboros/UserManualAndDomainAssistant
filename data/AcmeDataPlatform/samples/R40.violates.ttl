# R40: two dashboards nested in each other.
@prefix adp: <https://example.org/acme/data-platform#> .

adp:svcStorage a adp:PlatformService ; adp:serviceOwnedBy adp:storageTeam .
adp:storageTeam a adp:PlatformTeam .
adp:salesTeam a adp:ProductTeam .
adp:hrTeam a adp:ProductTeam .
adp:orderManagement a adp:DataSource .
adp:dashA a adp:Dashboard, adp:SubPlatformResource ; adp:belongsTo adp:dashB ; adp:createdBy adp:salesTeam ; adp:resourceOwnedBy adp:salesTeam ; adp:createdWith adp:svcStorage .
adp:dashB a adp:Dashboard, adp:SubPlatformResource ; adp:belongsTo adp:dashA ; adp:createdBy adp:salesTeam ; adp:resourceOwnedBy adp:salesTeam ; adp:createdWith adp:svcStorage .
