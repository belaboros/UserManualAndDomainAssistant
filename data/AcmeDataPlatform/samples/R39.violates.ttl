# R39: two data products depending on each other (a lineage cycle).
@prefix adp: <https://example.org/acme/data-platform#> .

adp:svcStorage a adp:PlatformService ; adp:serviceOwnedBy adp:storageTeam .
adp:storageTeam a adp:PlatformTeam .
adp:salesTeam a adp:ProductTeam .
adp:hrTeam a adp:ProductTeam .
adp:orderManagement a adp:DataSource .
adp:crmCustomers a adp:DataProduct ; adp:createdBy adp:salesTeam ; adp:resourceOwnedBy adp:salesTeam ; adp:createdWith adp:svcStorage ; adp:createdIn adp:DEV .
adp:crmCustomersContract a adp:DataContract, adp:SubPlatformResource ; adp:belongsTo adp:crmCustomers ; adp:createdBy adp:salesTeam ; adp:resourceOwnedBy adp:salesTeam ; adp:createdWith adp:svcStorage .
adp:crmCustomersPipeline a adp:IngestionDataPipeline, adp:SubPlatformResource ; adp:belongsTo adp:crmCustomers ; adp:createdBy adp:salesTeam ; adp:resourceOwnedBy adp:salesTeam ; adp:createdWith adp:svcStorage ; adp:ingestsFrom adp:orderManagement ; adp:populates adp:crmCustomersAsset .
adp:crmCustomersCluster a adp:ComputeClusterDefinition, adp:SubPlatformResource ; adp:belongsTo adp:crmCustomers ; adp:createdBy adp:salesTeam ; adp:resourceOwnedBy adp:salesTeam ; adp:createdWith adp:svcStorage .
adp:crmCustomersWorkspace a adp:WorkspaceInfraDefinition, adp:SubPlatformResource ; adp:belongsTo adp:crmCustomers ; adp:createdBy adp:salesTeam ; adp:resourceOwnedBy adp:salesTeam ; adp:createdWith adp:svcStorage .
adp:crmCustomersAsset a adp:DataAsset, adp:SubPlatformResource ; adp:belongsTo adp:crmCustomers ; adp:createdBy adp:salesTeam ; adp:resourceOwnedBy adp:salesTeam ; adp:createdWith adp:svcStorage ; adp:inLayer adp:RAW .
adp:crmCustomersHealth a adp:Dashboard, adp:SubPlatformResource ; adp:belongsTo adp:crmCustomers ; adp:createdBy adp:salesTeam ; adp:resourceOwnedBy adp:salesTeam ; adp:createdWith adp:svcStorage .
adp:salesOrders a adp:DataProduct ; adp:createdBy adp:salesTeam ; adp:resourceOwnedBy adp:salesTeam ; adp:createdWith adp:svcStorage ; adp:createdIn adp:DEV .
adp:salesOrdersContract a adp:DataContract, adp:SubPlatformResource ; adp:belongsTo adp:salesOrders ; adp:createdBy adp:salesTeam ; adp:resourceOwnedBy adp:salesTeam ; adp:createdWith adp:svcStorage .
adp:salesOrdersPipeline a adp:ProcessingDataPipeline, adp:SubPlatformResource ; adp:belongsTo adp:salesOrders ; adp:createdBy adp:salesTeam ; adp:resourceOwnedBy adp:salesTeam ; adp:createdWith adp:svcStorage ; adp:reads adp:crmCustomersAsset ; adp:populates adp:salesOrdersAsset .
adp:salesOrdersCluster a adp:ComputeClusterDefinition, adp:SubPlatformResource ; adp:belongsTo adp:salesOrders ; adp:createdBy adp:salesTeam ; adp:resourceOwnedBy adp:salesTeam ; adp:createdWith adp:svcStorage .
adp:salesOrdersWorkspace a adp:WorkspaceInfraDefinition, adp:SubPlatformResource ; adp:belongsTo adp:salesOrders ; adp:createdBy adp:salesTeam ; adp:resourceOwnedBy adp:salesTeam ; adp:createdWith adp:svcStorage .
adp:salesOrdersAsset a adp:DataAsset, adp:SubPlatformResource ; adp:belongsTo adp:salesOrders ; adp:createdBy adp:salesTeam ; adp:resourceOwnedBy adp:salesTeam ; adp:createdWith adp:svcStorage ; adp:inLayer adp:CURATED .
adp:salesOrdersHealth a adp:Dashboard, adp:SubPlatformResource ; adp:belongsTo adp:salesOrders ; adp:createdBy adp:salesTeam ; adp:resourceOwnedBy adp:salesTeam ; adp:createdWith adp:svcStorage .
adp:salesOrders adp:dependsOn adp:crmCustomers .
adp:crmCustomers adp:dependsOn adp:salesOrders .
