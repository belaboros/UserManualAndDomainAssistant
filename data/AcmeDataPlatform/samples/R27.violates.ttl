# R27: an ML model with a nested dashboard.
@prefix adp: <https://example.org/acme/data-platform#> .

adp:svcStorage a adp:PlatformService ; adp:serviceOwnedBy adp:storageTeam .
adp:storageTeam a adp:PlatformTeam .
adp:salesTeam a adp:ProductTeam .
adp:churnModel a adp:MLModel ; adp:createdBy adp:salesTeam ; adp:resourceOwnedBy adp:salesTeam ; adp:createdWith adp:svcStorage ; adp:createdIn adp:DEV .
adp:churnModelDash a adp:Dashboard, adp:SubPlatformResource ; adp:belongsTo adp:churnModel ; adp:createdBy adp:salesTeam ; adp:resourceOwnedBy adp:salesTeam ; adp:createdWith adp:svcStorage .
