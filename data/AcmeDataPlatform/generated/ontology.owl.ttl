    rdfs:label "received by"@en ;
    dcterms:source "S41" ;
    rdfs:domain adp:SubscriptionRequest ;
    rdfs:range adp:ProductOwner ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:requestConsumer a owl:ObjectProperty ;
    rdfs:label "consumer"@en ;
    dcterms:source "S40",
        "S42" ;
    rdfs:domain adp:SubscriptionRequest ;
    skos:definition "The new platform resource or the other application that will consume the subscribed platform resource."@en ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:requestFor a owl:ObjectProperty ;
    rdfs:label "subscribes to"@en ;
    dcterms:source "S40" ;
    rdfs:domain adp:SubscriptionRequest ;
    rdfs:range adp:PlatformResource ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:requestedBy a owl:ObjectProperty ;
    rdfs:label "created by"@en ;
    dcterms:source "S40" ;
    rdfs:domain adp:SubscriptionRequest ;
    rdfs:range adp:ProductOwner ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:requestedIn a owl:ObjectProperty ;
    rdfs:label "requested in"@en ;
    dcterms:source "S58" ;
    rdfs:domain adp:SubscriptionRequest ;
    rdfs:range adp:Environment ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:requiresManualApproval a owl:DatatypeProperty ;
    rdfs:label "requires manual approval"@en ;
    dcterms:source "S64" ;
    rdfs:domain adp:DataProduct ;
    rdfs:range xsd:boolean ;
    skos:definition "Set by the data product owner, per data product, for reasons such as security or an intentionally limited audience: subscription requests need his/her manual approval, also in EXP."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:reservedFor a owl:ObjectProperty ;
    rdfs:label "reserved for"@en ;
    dcterms:source "S65" ;
    rdfs:domain adp:PreApprovedBudget ;
    rdfs:range adp:BusinessCase ;
    skos:definition "The use case (business case) the pre-approved budget is for."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:resourceOwnedBy a owl:ObjectProperty ;
    rdfs:label "owned by"@en ;
    dcterms:source "S5" ;
    rdfs:domain adp:PlatformResource ;
    rdfs:range adp:ProductTeam ;
    rdfs:subPropertyOf adp:ownedBy ;
    skos:definition "The product team that owns a platform resource: the team which created it."@en ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:restrictedIn a owl:ObjectProperty ;
    rdfs:label "restricted in"@en ;
    dcterms:source "S55" ;
    rdfs:domain adp:AccessRestriction ;
    rdfs:range adp:Environment ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:restricts a owl:ObjectProperty ;
    rdfs:label "restricts"@en ;
    dcterms:source "S55" ;
    rdfs:domain adp:AccessRestriction ;
    rdfs:range adp:PlatformResource ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:resultOf a owl:ObjectProperty ;
    rdfs:label "result of"@en ;
    dcterms:source "S59",
        "S60" ;
    rdfs:domain adp:QualityGateResult ;
    rdfs:range adp:QualityGate ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:reviewAccepted a owl:DatatypeProperty ;
    rdfs:label "accepted"@en ;
    dcterms:source "S59" ;
    rdfs:domain adp:ManualReview ;
    rdfs:range xsd:boolean ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:sentTo a owl:ObjectProperty ;
    rdfs:label "sent to"@en ;
    dcterms:source "S60" ;
    rdfs:domain adp:Feedback ;
    rdfs:range adp:Team ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:serviceOwnedBy a owl:ObjectProperty ;
    rdfs:label "owned by"@en ;
    dcterms:source "S3" ;
    rdfs:domain adp:PlatformService ;
    rdfs:range adp:PlatformTeam ;
    rdfs:subPropertyOf adp:ownedBy ;
    skos:definition "The platform team that owns a platform service."@en ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:setBy a owl:ObjectProperty ;
    rdfs:label "set by"@en ;
    dcterms:source "S55",
        "S56" ;
    rdfs:domain adp:AccessRestriction ;
    rdfs:range adp:ProductOwner ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:sliFailing a owl:DatatypeProperty ;
    rdfs:label "failing"@en ;
    dcterms:source "S60",
        "S61" ;
    rdfs:domain adp:ServiceLevelIndicator ;
    rdfs:range xsd:boolean ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:toEnvironment a owl:ObjectProperty ;
    rdfs:label "to environment"@en ;
    dcterms:source "S62",
        "S8" ;
    rdfs:domain adp:Promotion ;
    rdfs:range adp:Environment ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:triggeredBy a owl:ObjectProperty ;
    rdfs:label "triggered by"@en ;
    dcterms:source "S61" ;
    rdfs:domain adp:Incident ;
    rdfs:range adp:ServiceLevelIndicator ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:validUntil a owl:DatatypeProperty ;
    rdfs:label "valid until"@en ;
    dcterms:source "S53" ;
    rdfs:domain adp:ElevatedPermission ;
    rdfs:range xsd:dateTime ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:Budget a owl:Class ;
    rdfs:label "budget"@en ;
    dcterms:source "S58",
        "S59",
        "S60",
        "S65" ;
    skos:definition "There are 2 kinds: the department-level pre-allocated budget (EXP) and the pre-approved budget of a product team (DEV/ACC/PRD)."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:DataPlatform a owl:Class ;
    rdfs:label "data platform"@en ;
    dcterms:source "S1" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:PlatformService ;
            owl:onProperty adp:consistsOf ] ;
    skos:definition "The kind of thing AcmeDataPlatform is."@en ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:DataSource a owl:Class ;
    rdfs:label "data source"@en ;
    dcterms:source "S25" ;
    skos:altLabel "source service"@en ;
    skos:definition "An internal or external service or data source that an ingestion data pipeline ingests data from."@en ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:ElevatedPermission a owl:Class ;
    rdfs:label "elevated permission"@en ;
    dcterms:source "S53" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty adp:validUntil ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass adp:Purpose ;
            owl:onProperty adp:forPurpose ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        adp:Permission ;
    skos:definition "A time-limited permission a developer of the consumer application requests to run SELECT commands on tables/views in their data product or in the parent data products, for incident resolution or debugging."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:Feedback a owl:Class ;
    rdfs:label "feedback"@en ;
    dcterms:source "S60" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adp:Team ;
            owl:onProperty adp:sentTo ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass adp:PlatformResource ;
            owl:onProperty adp:feedbackOn ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "What consumers send to the owner team after testing the next MAJOR/MINOR version in ACC."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:IngestionDataPipeline a owl:Class ;
    rdfs:label "ingestion data pipeline"@en ;
    dcterms:source "S25",
        "S30" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:DataSource ;
            owl:onProperty adp:ingestsFrom ],
        adp:DataPipeline ;
    owl:disjointWith adp:ProcessingDataPipeline ;
    skos:definition "A data pipeline that ingests data from an (internal or external) source service or data source and stores it unchanged in the RAW layer."@en ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:PlatformTeam a owl:Class ;
    rdfs:label "platform team"@en ;
    dcterms:source "S1",
        "S10",
        "S3" ;
    rdfs:subClassOf adp:Team ;
    owl:disjointWith adp:ProductTeam ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:Principal a owl:Class ;
    rdfs:label "principal"@en ;
    dcterms:source "S33" ;
    skos:definition "Someone or something that consumes platform resources: a user principal or a service principal."@en ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:ProcessingDataPipeline a owl:Class ;
    rdfs:label "processing data pipeline"@en ;
    dcterms:source "S25",
        "S30" ;
    rdfs:subClassOf adp:DataPipeline ;
    skos:definition "A data pipeline that performs transformations (cleansing, curation, filtering, enrichment, aggregation) across the RAW->CURATED->SERVING medallion layers."@en ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:Productionization a owl:Class ;
    rdfs:label "productionization"@en ;
    dcterms:source "S62" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adp:PlatformResource ;
            owl:onProperty adp:productionizes ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:Promotion ;
            owl:onProperty adp:promotionStep ] ;
    skos:definition "The promotion and approval process to deploy platform resources from lower environments to upper environments till PRD."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:belongsTo a owl:FunctionalProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "belongs to"@en ;
    dcterms:source "S18" ;
    rdfs:domain adp:SubPlatformResource ;
    rdfs:range adp:PlatformResource ;
    owl:inverseOf adp:hasSubResource ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:ownedBy a owl:ObjectProperty ;
    rdfs:label "owned by"@en ;
    dcterms:source "S3",
        "S5" ;
    rdfs:range adp:Team ;
    skos:definition "The team that owns a platform service (a platform team) or a platform resource (the product team that created it)."@en ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:AccessRestriction a owl:Class ;
    rdfs:label "access restriction"@en ;
    dcterms:source "S55",
        "S56" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adp:ProductOwner ;
            owl:onProperty adp:setBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:Environment ;
            owl:onProperty adp:restrictedIn ],
        [ a owl:Restriction ;
            owl:onClass adp:PlatformResource ;
            owl:onProperty adp:restricts ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "A limit a product owner intentionally sets on the default read access of the owner team's members to their own platform resource, in some environments (e.g. not in PRD, which contains sensitive/PII information)."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:BudgetAdjustmentRequest a owl:Class ;
    rdfs:label "budget adjustment request"@en ;
    dcterms:source "S63" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adp:PreApprovedBudget ;
            owl:onProperty adp:adjustmentOf ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass adp:Team ;
            owl:onProperty adp:adjustmentRequestedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass adp:Department ;
            owl:onProperty adp:adjustmentRequestedFrom ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "A request by the owner team to its department to adjust the pre-approved development budget, if needed."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:ComputeClusterDefinition a owl:Class ;
    rdfs:label "compute cluster definition"@en ;
    dcterms:source "S20" ;
    rdfs:subClassOf adp:SubPlatformResource ;
    owl:disjointWith adp:AIAnalyticalApplication,
        adp:AIModel,
        adp:Dashboard,
        adp:DataAsset,
        adp:DataProduct,
        adp:MLModel,
        adp:WorkspaceInfraDefinition ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:ManualReview a owl:Class ;
    rdfs:label "manual review"@en ;
    dcterms:source "S59" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty adp:reviewAccepted ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass adp:Team ;
            owl:onProperty adp:defendedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "The review a failed BLOCKING quality gate requires, in which the owning team defends why its solution does not use the available standard solutions."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:QualityGateResult a owl:Class ;
    rdfs:label "quality gate result"@en ;
    dcterms:source "S59",
        "S60" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty adp:gatePassed ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass adp:QualityGate ;
            owl:onProperty adp:resultOf ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "The outcome (passed or failed) of one quality gate for one promotion."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:ServiceLevelObjective a owl:Class ;
    rdfs:label "service level objective"@en ;
    dcterms:source "S59" ;
    skos:altLabel "SLO"@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:ServicePrincipal a owl:Class ;
    rdfs:label "service principal"@en ;
    dcterms:source "S33",
        "S34" ;
    rdfs:subClassOf adp:Principal ;
    skos:altLabel "application consumer"@en ;
    skos:definition "The identity of an application, data pipeline or other automation which is not performed by a human."@en ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:Privilege a owl:Class ;
    rdfs:label "privilege"@en ;
    dcterms:source "S52",
        "S53" ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:Purpose a owl:Class ;
    rdfs:label "purpose"@en ;
    dcterms:source "S53" ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:ResourceLimitation a owl:Class ;
    rdfs:label "resource limitation"@en ;
    dcterms:source "S58" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:Environment ;
            owl:onProperty adp:limitationIn ] ;
    skos:definition "A limit on platform resources in EXP that avoids production usage."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:VersionUpgrade a owl:Class ;
    rdfs:label "version upgrade"@en ;
    dcterms:source "S59",
        "S60" ;
    skos:definition "The kind of new version a promotion delivers: MAJOR or MINOR; decided in DEV."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:WorkspaceInfraDefinition a owl:Class ;
    rdfs:label "workspace infra definition"@en ;
    dcterms:source "S20" ;
    rdfs:subClassOf adp:SubPlatformResource ;
    owl:disjointWith adp:AIAnalyticalApplication,
        adp:AIModel,
        adp:Dashboard,
        adp:DataAsset,
        adp:DataProduct,
        adp:MLModel ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:EXP a owl:NamedIndividual,
        adp:Environment ;
    rdfs:label "EXP"@en ;
    dcterms:source "S1",
        "S11",
        "S12",
        "S58",
        "S7",
        "S8" ;
    skos:definition "The environment for experimentation and learning, with the highest degree of freedom: start experimenting in minutes, without prior approval for permission or budget."@en ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:Employee a owl:Class ;
    rdfs:label "employee"@en ;
    dcterms:source "S50" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adp:UserPrincipal ;
            owl:onProperty adp:hasUserPrincipal ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "A person working for ACME company, e.g. a product owner or data product owner."@en ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:GateSeverity a owl:Class ;
    rdfs:label "gate severity"@en ;
    dcterms:source "S59",
        "S60" ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:ServiceLevelIndicator a owl:Class ;
    rdfs:label "service level indicator"@en ;
    dcterms:source "S59",
        "S60",
        "S61" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty adp:sliFailing ],
        [ a owl:Restriction ;
            owl:onClass adp:Environment ;
            owl:onProperty adp:monitoredIn ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass adp:ServiceLevelObjective ;
            owl:onProperty adp:measures ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:altLabel "SLI"@en ;
    skos:definition "An automatically monitored measure of a service level objective, in one environment."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:SubscriptionStatus a owl:Class ;
    rdfs:label "subscription status"@en ;
    dcterms:source "S41" ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:BusinessCase a owl:Class ;
    rdfs:label "business case"@en ;
    dcterms:source "S58",
        "S59" ;
    skos:altLabel "use case"@en ;
    skos:definition "The approved reason for building a platform resource; an outcome of EXP, needed to work in DEV."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:Catalog a owl:Class ;
    rdfs:label "catalog"@en ;
    dcterms:source "S38",
        "S49" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adp:Environment ;
            owl:onProperty adp:catalogOf ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Where the platform resources of one environment are exposed (findable) for anyone inside ACME company; there is a catalog per environment."@en ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:DEV a owl:NamedIndividual,
        adp:Environment ;
    rdfs:label "DEV"@en ;
    dcterms:source "S1",
        "S11",
        "S59",
        "S7",
        "S8" ;
    skos:definition "The environment where platform resources are created via repeatable automation, so they can be deployed to upper environments reliably; less freedom than EXP."@en ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:DataPipeline a owl:Class ;
    rdfs:label "data pipeline"@en ;
    dcterms:source "S20" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:DataAsset ;
            owl:onProperty adp:populates ],
        adp:SubPlatformResource ;
    owl:disjointWith adp:AIAnalyticalApplication,
        adp:AIModel,
        adp:ComputeClusterDefinition,
        adp:Dashboard,
        adp:DataAsset,
        adp:DataProduct,
        adp:MLModel,
        adp:WorkspaceInfraDefinition ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( adp:IngestionDataPipeline adp:ProcessingDataPipeline ) ] ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:Department a owl:Class ;
    rdfs:label "department"@en ;
    dcterms:source "S58" ;
    skos:definition "An organisational unit whose product teams build on the AcmeDataPlatform; it provides the EXP budget for them."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:PRD a owl:NamedIndividual,
        adp:Environment ;
    rdfs:label "PRD"@en ;
    dcterms:source "S1",
        "S14",
        "S61",
        "S8" ;
    skos:definition "The live environment, with the least freedom: maximum protection via policies, limited access and audit log."@en ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:Permission a owl:Class ;
    rdfs:label "permission"@en ;
    dcterms:source "S52" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:Privilege ;
            owl:onProperty adp:grantsPrivilege ],
        [ a owl:Restriction ;
            owl:onClass adp:UserPrincipal ;
            owl:onProperty adp:grantedTo ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass adp:Environment ;
            owl:onProperty adp:inEnvironment ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:DataAsset ;
            owl:onProperty adp:permissionOn ] ;
    skos:definition "Access for a user principal to tables/views in one environment, e.g. SELECT; access for users can be differentiated per environment."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:PreApprovedBudget a owl:Class ;
    rdfs:label "pre-approved budget"@en ;
    dcterms:source "S58",
        "S59",
        "S60",
        "S63",
        "S65" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adp:BusinessCase ;
            owl:onProperty adp:reservedFor ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass adp:ProductTeam ;
            owl:onProperty adp:budgetOfTeam ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        adp:Budget ;
    skos:altLabel "development budget"@en,
        "reserved budget"@en ;
    skos:definition "The DEV/ACC/PRD budget for the use case / platform resource of one product team (an outcome of EXP); automated budget tests validate that the costs fit into it, and the owner team may request an adjustment from its department."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:UserPrincipal a owl:Class ;
    rdfs:label "user principal"@en ;
    dcterms:source "S33",
        "S34" ;
    rdfs:subClassOf adp:Principal ;
    owl:disjointWith adp:ServicePrincipal ;
    skos:altLabel "human user"@en ;
    skos:definition "The identity of a user or group of users who can look at dashboards and use AI/analytical applications."@en ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:Warning a owl:NamedIndividual,
        adp:GateSeverity ;
    rdfs:label "WARNING"@en ;
    dcterms:source "S59",
        "S60" ;
    skos:definition "A failed gate is reported but does not stop the promotion."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:PlatformService a owl:Class ;
    rdfs:label "platform service"@en ;
    dcterms:source "S1",
        "S2",
        "S3",
        "S4",
        "S6" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adp:PlatformTeam ;
            owl:onProperty adp:serviceOwnedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:SubPlatformResource a owl:Class ;
    rdfs:label "sub platform resource"@en ;
    dcterms:source "S18" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adp:PlatformResource ;
            owl:onProperty adp:belongsTo ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        adp:PlatformResource ;
    skos:altLabel "nested platform resource"@en ;
    skos:definition "A platform resource that belongs to a parent platform resource and cannot live on its own."@en ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:SubscriptionRequest a owl:Class ;
    rdfs:label "subscription request"@en ;
    dcterms:source "S40",
        "S41" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:Environment ;
            owl:onProperty adp:requestedIn ],
        [ a owl:Restriction ;
            owl:onClass adp:ProductOwner ;
            owl:onProperty adp:requestedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty adp:requestConsumer ],
        [ a owl:Restriction ;
            owl:onClass adp:PlatformResource ;
            owl:onProperty adp:requestFor ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass adp:SubscriptionStatus ;
            owl:onProperty adp:hasStatus ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass adp:ProductOwner ;
            owl:onProperty adp:receivedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "A request by a product owner to consume an existing platform resource, to build a new platform resource or to consume it by another application."@en ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:Blocking a owl:NamedIndividual,
        adp:GateSeverity ;
    rdfs:label "BLOCKING"@en ;
    dcterms:source "S59",
        "S60" ;
    skos:definition "A failed gate stops the promotion until a manual review accepts it."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:MLModel a owl:Class ;
    rdfs:label "ML model"@en ;
    dcterms:source "S18",
        "S9" ;
    rdfs:subClassOf adp:PlatformResource ;
    owl:disjointWith adp:AIAnalyticalApplication,
        adp:AIModel ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:MedallionLayer a owl:Class ;
    rdfs:label "medallion layer"@en ;
    dcterms:source "S25" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:MedallionLayer ;
            owl:onProperty adp:nextLayer ] ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:AIModel a owl:Class ;
    rdfs:label "AI model"@en ;
    dcterms:source "S18",
        "S9" ;
    rdfs:subClassOf adp:PlatformResource ;
    owl:disjointWith adp:AIAnalyticalApplication ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:Dashboard a owl:Class ;
    rdfs:label "dashboard"@en ;
    dcterms:source "S18",
        "S9" ;
    rdfs:subClassOf adp:PlatformResource ;
    owl:disjointWith adp:AIAnalyticalApplication,
        adp:AIModel,
        adp:MLModel ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:Promotion a owl:Class ;
    rdfs:label "promotion"@en ;
    dcterms:source "S62",
        "S8" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adp:Environment ;
            owl:onProperty adp:toEnvironment ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass adp:Environment ;
            owl:onProperty adp:fromEnvironment ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty adp:breakingChange ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:VersionUpgrade ;
            owl:onProperty adp:hasVersionUpgrade ],
        [ a owl:Restriction ;
            owl:onClass adp:PlatformResource ;
            owl:onProperty adp:promotionOf ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "One step of a productionization: a platform resource is deployed from one environment to the next upper environment."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:Team a owl:Class ;
    rdfs:label "team"@en ;
    dcterms:source "S10" ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:Tool a owl:Class ;
    rdfs:label "tool"@en ;
    dcterms:source "S58",
        "S59" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:Environment ;
            owl:onProperty adp:offeredIn ] ;
    skos:definition "Tooling offered to the teams in an environment, e.g. the internal developer portal in EXP or IaC tools in DEV."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:AIAnalyticalApplication a owl:Class ;
    rdfs:label "AI/analytical application"@en ;
    dcterms:source "S9" ;
    rdfs:subClassOf adp:PlatformResource ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:ProductOwner a owl:Class ;
    rdfs:label "product owner"@en ;
    dcterms:source "S37",
        "S50" ;
    rdfs:subClassOf adp:Employee ;
    skos:definition "The member of the owner product team who owns a platform resource on its behalf."@en ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:ProductTeam a owl:Class ;
    rdfs:label "product team"@en ;
    dcterms:source "S1",
        "S10",
        "S4",
        "S5" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:Department ;
            owl:onProperty adp:belongsToDepartment ],
        adp:Team ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:ACC a owl:NamedIndividual,
        adp:Environment ;
    rdfs:label "ACC"@en ;
    dcterms:source "S1",
        "S13",
        "S14",
        "S60",
        "S8" ;
    skos:definition "The production-like environment, fully automated (deployment only via CI/CD pipeline), to prepare the deployment and UAT tests of the next MAJOR/MINOR versions and collect consumer feedback; less freedom than DEV."@en ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:DataProduct a owl:Class ;
    rdfs:label "data product"@en ;
    dcterms:source "S18",
        "S9" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty adp:requiresManualApproval ],
        adp:PlatformResource ;
    owl:disjointWith adp:AIAnalyticalApplication,
        adp:AIModel,
        adp:Dashboard,
        adp:MLModel ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:DataAsset a owl:Class ;
    rdfs:label "data asset"@en ;
    dcterms:source "S20" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adp:MedallionLayer ;
            owl:onProperty adp:inLayer ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        adp:SubPlatformResource ;
    owl:disjointWith adp:AIAnalyticalApplication,
        adp:AIModel,
        adp:Dashboard,
        adp:DataProduct,
        adp:MLModel ;
    skos:definition "A part of a data product holding its data; typically tables and views in case of structured data products."@en ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:QualityGate a owl:Class ;
    rdfs:label "quality gate"@en ;
    dcterms:source "S59",
        "S60" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty adp:gateMandatory ],
        [ a owl:Restriction ;
            owl:onClass adp:Environment ;
            owl:onProperty adp:gatesPromotionTo ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass adp:GateSeverity ;
            owl:onProperty adp:hasSeverity ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "A check a platform resource must pass to be promoted to an environment; it is BLOCKED, BLOCKING or a WARNING."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:Environment a owl:Class ;
    rdfs:label "environment"@en ;
    dcterms:source "S1",
        "S6",
        "S7",
        "S8" ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:PlatformResource a owl:Class ;
    rdfs:label "platform resource"@en ;
    dcterms:source "S1",
        "S11",
        "S14",
        "S15",
        "S4",
        "S5",
        "S7",
        "S8",
        "S9" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adp:ProductTeam ;
            owl:onProperty adp:resourceOwnedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass adp:ProductTeam ;
            owl:onProperty adp:createdBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass adp:Environment ;
            owl:onProperty adp:createdIn ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty adp:externallyShared ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:ProductOwner ;
            owl:onProperty adp:hasProductOwner ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty adp:exposedInCatalog ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:PlatformService ;
            owl:onProperty adp:createdWith ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:BusinessCase ;
            owl:onProperty adp:hasBusinessCase ] ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( adp:DataProduct adp:Dashboard adp:MLModel adp:AIModel adp:AIAnalyticalApplication adp:DataContract adp:DataPipeline adp:ComputeClusterDefinition adp:WorkspaceInfraDefinition adp:DataAsset ) ] ;
    adp:level 1 ;
    adp:status "confirmed" .

