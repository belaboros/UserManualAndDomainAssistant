    dcterms:source "S25",
        "S30" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:DataSource ;
            owl:onProperty adp:ingestsFrom ],
        adp:DataPipeline ;
    owl:disjointWith adp:ProcessingDataPipeline ;
    skos:definition "A data pipeline that ingests data from an (internal or external) source service or data source and stores it unchanged in the RAW layer."@en ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:PlatformTeam a owl:Class ;
    rdfs:label "platform team"@en ;
    dcterms:source "S1",
        "S10",
        "S3" ;
    rdfs:subClassOf adp:Team ;
    owl:disjointWith adp:ProductTeam ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:Principal a owl:Class ;
    rdfs:label "principal"@en ;
    dcterms:source "S33" ;
    skos:definition "Someone or something that consumes platform resources: a user principal or a service principal."@en ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:ProcessingDataPipeline a owl:Class ;
    rdfs:label "processing data pipeline"@en ;
    dcterms:source "S25",
        "S30" ;
    rdfs:subClassOf adp:DataPipeline ;
    skos:definition "A data pipeline that performs transformations (cleansing, curation, filtering, enrichment, aggregation) across the RAW->CURATED->SERVING medallion layers."@en ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:belongsTo a owl:FunctionalProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "belongs to"@en ;
    dcterms:source "S18" ;
    rdfs:domain adp:SubPlatformResource ;
    rdfs:range adp:PlatformResource ;
    owl:inverseOf adp:hasSubResource ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:ownedBy a owl:ObjectProperty ;
    rdfs:label "owned by"@en ;
    dcterms:source "S3",
        "S5" ;
    rdfs:range adp:Team ;
    skos:definition "The team that owns a platform service (a platform team) or a platform resource (the product team that created it)."@en ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:AccessRestriction a owl:Class ;
    rdfs:label "access restriction"@en ;
    dcterms:source "S55",
        "S56" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adp:ProductOwner ;
            owl:onProperty adp:setBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:Environment ;
            owl:onProperty adp:restrictedIn ],
        [ a owl:Restriction ;
            owl:onClass adp:PlatformResource ;
            owl:onProperty adp:restricts ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "A limit a product owner intentionally sets on the default read access of the owner team's members to their own platform resource, in some environments (e.g. not in PRD, which contains sensitive/PII information)."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:ComputeClusterDefinition a owl:Class ;
    rdfs:label "compute cluster definition"@en ;
    dcterms:source "S20" ;
    rdfs:subClassOf adp:SubPlatformResource ;
    owl:disjointWith adp:AIAnalyticalApplication,
        adp:AIModel,
        adp:Dashboard,
        adp:DataAsset,
        adp:DataProduct,
        adp:MLModel,
        adp:WorkspaceInfraDefinition ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:ServicePrincipal a owl:Class ;
    rdfs:label "service principal"@en ;
    dcterms:source "S33",
        "S34" ;
    rdfs:subClassOf adp:Principal ;
    skos:altLabel "application consumer"@en ;
    skos:definition "The identity of an application, data pipeline or other automation which is not performed by a human."@en ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:Team a owl:Class ;
    rdfs:label "team"@en ;
    dcterms:source "S10" ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:Privilege a owl:Class ;
    rdfs:label "privilege"@en ;
    dcterms:source "S52",
        "S53" ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:Purpose a owl:Class ;
    rdfs:label "purpose"@en ;
    dcterms:source "S53" ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:WorkspaceInfraDefinition a owl:Class ;
    rdfs:label "workspace infra definition"@en ;
    dcterms:source "S20" ;
    rdfs:subClassOf adp:SubPlatformResource ;
    owl:disjointWith adp:AIAnalyticalApplication,
        adp:AIModel,
        adp:Dashboard,
        adp:DataAsset,
        adp:DataProduct,
        adp:MLModel ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:Employee a owl:Class ;
    rdfs:label "employee"@en ;
    dcterms:source "S50" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adp:UserPrincipal ;
            owl:onProperty adp:hasUserPrincipal ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "A person working for ACME company, e.g. a product owner or data product owner."@en ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:SubscriptionStatus a owl:Class ;
    rdfs:label "subscription status"@en ;
    dcterms:source "S41" ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:Catalog a owl:Class ;
    rdfs:label "catalog"@en ;
    dcterms:source "S38",
        "S49" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adp:Environment ;
            owl:onProperty adp:catalogOf ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Where the platform resources of one environment are exposed (findable) for anyone inside ACME company; there is a catalog per environment."@en ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:DataPipeline a owl:Class ;
    rdfs:label "data pipeline"@en ;
    dcterms:source "S20" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:DataAsset ;
            owl:onProperty adp:populates ],
        adp:SubPlatformResource ;
    owl:disjointWith adp:AIAnalyticalApplication,
        adp:AIModel,
        adp:ComputeClusterDefinition,
        adp:Dashboard,
        adp:DataAsset,
        adp:DataProduct,
        adp:MLModel,
        adp:WorkspaceInfraDefinition ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( adp:IngestionDataPipeline adp:ProcessingDataPipeline ) ] ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:Permission a owl:Class ;
    rdfs:label "permission"@en ;
    dcterms:source "S52" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:Privilege ;
            owl:onProperty adp:grantsPrivilege ],
        [ a owl:Restriction ;
            owl:onClass adp:UserPrincipal ;
            owl:onProperty adp:grantedTo ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass adp:Environment ;
            owl:onProperty adp:inEnvironment ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:DataAsset ;
            owl:onProperty adp:permissionOn ] ;
    skos:definition "Access for a user principal to tables/views in one environment, e.g. SELECT; access for users can be differentiated per environment."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:SubscriptionRequest a owl:Class ;
    rdfs:label "subscription request"@en ;
    dcterms:source "S40",
        "S41" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adp:ProductOwner ;
            owl:onProperty adp:requestedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty adp:requestConsumer ],
        [ a owl:Restriction ;
            owl:onClass adp:PlatformResource ;
            owl:onProperty adp:requestFor ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass adp:SubscriptionStatus ;
            owl:onProperty adp:hasStatus ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass adp:ProductOwner ;
            owl:onProperty adp:receivedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "A request by a product owner to consume an existing platform resource, to build a new platform resource or to consume it by another application."@en ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:UserPrincipal a owl:Class ;
    rdfs:label "user principal"@en ;
    dcterms:source "S33",
        "S34" ;
    rdfs:subClassOf adp:Principal ;
    owl:disjointWith adp:ServicePrincipal ;
    skos:altLabel "human user"@en ;
    skos:definition "The identity of a user or group of users who can look at dashboards and use AI/analytical applications."@en ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:PlatformService a owl:Class ;
    rdfs:label "platform service"@en ;
    dcterms:source "S1",
        "S2",
        "S3",
        "S4",
        "S6" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adp:PlatformTeam ;
            owl:onProperty adp:serviceOwnedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:SubPlatformResource a owl:Class ;
    rdfs:label "sub platform resource"@en ;
    dcterms:source "S18" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adp:PlatformResource ;
            owl:onProperty adp:belongsTo ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        adp:PlatformResource ;
    skos:altLabel "nested platform resource"@en ;
    skos:definition "A platform resource that belongs to a parent platform resource and cannot live on its own."@en ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:MLModel a owl:Class ;
    rdfs:label "ML model"@en ;
    dcterms:source "S18",
        "S9" ;
    rdfs:subClassOf adp:PlatformResource ;
    owl:disjointWith adp:AIAnalyticalApplication,
        adp:AIModel ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:MedallionLayer a owl:Class ;
    rdfs:label "medallion layer"@en ;
    dcterms:source "S25" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:MedallionLayer ;
            owl:onProperty adp:nextLayer ] ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:ProductTeam a owl:Class ;
    rdfs:label "product team"@en ;
    dcterms:source "S1",
        "S10",
        "S4",
        "S5" ;
    rdfs:subClassOf adp:Team ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:AIModel a owl:Class ;
    rdfs:label "AI model"@en ;
    dcterms:source "S18",
        "S9" ;
    rdfs:subClassOf adp:PlatformResource ;
    owl:disjointWith adp:AIAnalyticalApplication ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:Dashboard a owl:Class ;
    rdfs:label "dashboard"@en ;
    dcterms:source "S18",
        "S9" ;
    rdfs:subClassOf adp:PlatformResource ;
    owl:disjointWith adp:AIAnalyticalApplication,
        adp:AIModel,
        adp:MLModel ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:DataProduct a owl:Class ;
    rdfs:label "data product"@en ;
    dcterms:source "S18",
        "S9" ;
    rdfs:subClassOf adp:PlatformResource ;
    owl:disjointWith adp:AIAnalyticalApplication,
        adp:AIModel,
        adp:Dashboard,
        adp:MLModel ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:AIAnalyticalApplication a owl:Class ;
    rdfs:label "AI/analytical application"@en ;
    dcterms:source "S9" ;
    rdfs:subClassOf adp:PlatformResource ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:ProductOwner a owl:Class ;
    rdfs:label "product owner"@en ;
    dcterms:source "S37",
        "S50" ;
    rdfs:subClassOf adp:Employee ;
    skos:definition "The member of the owner product team who owns a platform resource on its behalf."@en ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:DataAsset a owl:Class ;
    rdfs:label "data asset"@en ;
    dcterms:source "S20" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adp:MedallionLayer ;
            owl:onProperty adp:inLayer ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        adp:SubPlatformResource ;
    owl:disjointWith adp:AIAnalyticalApplication,
        adp:AIModel,
        adp:Dashboard,
        adp:DataProduct,
        adp:MLModel ;
    skos:definition "A part of a data product holding its data; typically tables and views in case of structured data products."@en ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:Environment a owl:Class ;
    rdfs:label "environment"@en ;
    dcterms:source "S1",
        "S6",
        "S7",
        "S8" ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:PlatformResource a owl:Class ;
    rdfs:label "platform resource"@en ;
    dcterms:source "S1",
        "S11",
        "S14",
        "S15",
        "S4",
        "S5",
        "S7",
        "S8",
        "S9" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adp:ProductTeam ;
            owl:onProperty adp:resourceOwnedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass adp:ProductTeam ;
            owl:onProperty adp:createdBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass adp:Environment ;
            owl:onProperty adp:createdIn ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty adp:externallyShared ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:ProductOwner ;
            owl:onProperty adp:hasProductOwner ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty adp:exposedInCatalog ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:PlatformService ;
            owl:onProperty adp:createdWith ] ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( adp:DataProduct adp:Dashboard adp:MLModel adp:AIModel adp:AIAnalyticalApplication adp:DataContract adp:DataPipeline adp:ComputeClusterDefinition adp:WorkspaceInfraDefinition adp:DataAsset ) ] ;
    adp:level 1 ;
    adp:status "confirmed" .

