adp:ExperimentationBudget a owl:Class ;
    rdfs:label "department budget"@en ;
    dcterms:source "S58",
        "S65" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adp:Department ;
            owl:onProperty adp:providedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        adp:Budget ;
    owl:disjointWith adp:PreApprovedBudget ;
    skos:altLabel "department-level pre-allocated budget"@en,
        "experimentation budget"@en ;
    skos:definition "The EXP budget: pre-allocated by a department upfront, collectively for each month, for all its product teams and their platform resources."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:ExternalApplication a owl:Class ;
    rdfs:label "external application"@en ;
    dcterms:source "S35" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass adp:ProductOwner ;
            owl:onProperty adp:externalAppOwner ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "An application that runs outside of the data platform and consumes the externally exposed/shared platform resources."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:Incident a owl:Class ;
    rdfs:label "incident"@en ;
    dcterms:source "S61" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:ServiceLevelIndicator ;
            owl:onProperty adp:triggeredBy ] ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:ProofOfConcept a owl:Class ;
    rdfs:label "proof of concept"@en ;
    dcterms:source "S58" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass adp:BusinessCase ;
            owl:onProperty adp:provesCase ] ;
    skos:altLabel "POC"@en ;
    skos:definition "The outcome of experimentation in EXP: fit for the purpose, with knowledge about the expected costs."@en ;
    adp:level 3 ;
    adp:status "confirmed" .

