{
  "@context": {
    "adp": "https://example.org/acme/data-platform#",
    "dct": "http://purl.org/dc/terms/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "sh": "http://www.w3.org/ns/shacl#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "adp:level",
      "@type": "owl:AnnotationProperty",
      "rdfs:label": {
        "@language": "en",
        "@value": "learnability level"
      },
      "rdfs:range": {
        "@id": "xsd:integer"
      }
    },
    {
      "@id": "adp:status",
      "@type": "owl:AnnotationProperty",
      "rdfs:label": {
        "@language": "en",
        "@value": "status (confirmed or draft)"
      }
    },
    {
      "@id": "dct:source",
      "@type": "owl:AnnotationProperty"
    },
    {
      "@id": "https://example.org/acme/data-platform",
      "@type": "owl:Ontology",
      "rdfs:label": {
        "@language": "en",
        "@value": "AcmeDataPlatform ontology"
      }
    },
    {
      "@id": "skos:altLabel",
      "@type": "owl:AnnotationProperty"
    },
    {
      "@id": "skos:definition",
      "@type": "owl:AnnotationProperty"
    }
  ]
}
