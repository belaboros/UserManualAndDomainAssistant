        "S14",
        "S60",
        "S8"
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "ACC"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The production-like environment, fully automated (deployment only via CI/CD pipeline), to prepare the deployment and UAT tests of the next MAJOR/MINOR versions and collect consumer feedback; less freedom than DEV."
      }
    },
