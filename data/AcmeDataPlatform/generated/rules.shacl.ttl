adp:R38_shape a sh:NodeShape ;
    rdfs:label "A data product is created via ingestion or from parent data products."@en ;
    dct:source "S25" ;
    sh:message "A data product is created via ingestion or from parent data products."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A data product is created via ingestion or from parent data products."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this WHERE {
  FILTER NOT EXISTS { ?pipeline adp:belongsTo $this . ?pipeline a adp:IngestionDataPipeline . }
