adp:R10_shape a sh:NodeShape ;
    rdfs:label "A platform resource promoted to DEV was created in EXP."@en ;
    dct:source "S11",
        "S8" ;
    sh:message "A platform resource promoted to DEV was created in EXP."@en ;
    sh:or ( [ sh:not [ a sh:PropertyShape ;
                        sh:hasValue adp:DEV ;
                        sh:path adp:promotedTo ] ] [ a sh:PropertyShape ;
                sh:hasValue adp:EXP ;
                sh:path adp:createdIn ] ) ;
    sh:targetClass adp:PlatformResource ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:R11_shape a sh:NodeShape ;
    rdfs:label "A platform resource promoted to ACC was created in or promoted to DEV first."@en ;
    dct:source "S11",
        "S13",
        "S8" ;
    sh:message "A platform resource promoted to ACC was created in or promoted to DEV first."@en ;
    sh:or ( [ sh:not [ a sh:PropertyShape ;
                        sh:hasValue adp:ACC ;
                        sh:path adp:promotedTo ] ] [ a sh:PropertyShape ;
                sh:hasValue adp:DEV ;
                sh:path [ sh:alternativePath ( adp:createdIn adp:promotedTo ) ] ] ) ;
    sh:targetClass adp:PlatformResource ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:R12_shape a sh:NodeShape ;
    rdfs:label "A platform resource promoted to PRD was promoted to ACC first."@en ;
    dct:source "S11",
        "S14",
        "S8" ;
    sh:message "A platform resource promoted to PRD was promoted to ACC first."@en ;
    sh:or ( [ sh:not [ a sh:PropertyShape ;
                        sh:hasValue adp:PRD ;
                        sh:path adp:promotedTo ] ] [ a sh:PropertyShape ;
                sh:hasValue adp:ACC ;
                sh:path adp:promotedTo ] ) ;
    sh:targetClass adp:PlatformResource ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:R13_shape a sh:NodeShape ;
    rdfs:label "A sub platform resource belongs to exactly one parent platform resource; it cannot live on its own."@en ;
    dct:source "S18" ;
    sh:message "A sub platform resource belongs to exactly one parent platform resource; it cannot live on its own."@en ;
    sh:property adp:R13_shape_property ;
    sh:targetClass adp:SubPlatformResource ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R14_shape a sh:NodeShape ;
    rdfs:label "A sub platform resource is created by the same product team as its parent platform resource."@en ;
    dct:source "S18",
        "S27" ;
    sh:message "A sub platform resource is created by the same product team as its parent platform resource."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A sub platform resource is created by the same product team as its parent platform resource."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this ?value WHERE {
  { $this adp:createdBy ?value . FILTER NOT EXISTS { $this adp:belongsTo/adp:createdBy ?value } }
  UNION { $this adp:belongsTo/adp:createdBy ?value . FILTER NOT EXISTS { $this adp:createdBy ?value } }
}""" ] ;
    sh:targetClass adp:SubPlatformResource ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R15_shape a sh:NodeShape ;
    rdfs:label "A sub platform resource is created in the environment of its parent platform resource."@en ;
    dct:source "S18",
        "S19",
        "S27" ;
    sh:message "A sub platform resource is created in the environment of its parent platform resource."@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object [ sh:path ( [ sh:oneOrMorePath adp:belongsTo ] adp:createdIn ) ] ;
            sh:predicate adp:createdIn ;
            sh:subject sh:this ] ;
    sh:targetClass adp:SubPlatformResource ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R16_shape a sh:NodeShape ;
    rdfs:label "A sub platform resource is promoted with its parent platform resource."@en ;
    dct:source "S19",
        "S27" ;
    sh:message "A sub platform resource is promoted with its parent platform resource."@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object [ sh:path ( [ sh:oneOrMorePath adp:belongsTo ] adp:promotedTo ) ] ;
            sh:predicate adp:promotedTo ;
            sh:subject sh:this ] ;
    sh:targetClass adp:SubPlatformResource ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R17_shape a sh:NodeShape ;
    rdfs:label "A sub platform resource is never promoted on its own: it is in exactly the environments its parent was promoted to."@en ;
    dct:source "S19" ;
    sh:message "A sub platform resource is never promoted on its own: it is in exactly the environments its parent was promoted to."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A sub platform resource is never promoted on its own: it is in exactly the environments its parent was promoted to."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this ?value WHERE {
  { $this adp:promotedTo ?value . FILTER NOT EXISTS { $this adp:belongsTo/adp:promotedTo ?value } }
  UNION { $this adp:belongsTo/adp:promotedTo ?value . FILTER NOT EXISTS { $this adp:promotedTo ?value } }
}""" ] ;
    sh:targetClass adp:SubPlatformResource ;
    adp:level 2 ;
    adp:status "confirmed" .

