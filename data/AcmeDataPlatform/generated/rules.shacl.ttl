adp:R24_shape a sh:NodeShape ;
    rdfs:label "A data product consists only of the sub platform resources listed for it."@en ;
    dct:source "S20",
        "S22" ;
    sh:message "A data product consists only of the sub platform resources listed for it."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A data product consists only of the sub platform resources listed for it."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this WHERE {
  ?sub adp:belongsTo $this .
  FILTER NOT EXISTS { ?sub a ?kind . FILTER (?kind IN (adp:DataContract, adp:DataPipeline, adp:ComputeClusterDefinition, adp:WorkspaceInfraDefinition, adp:DataAsset, adp:Dashboard)) }
}
""" ] ;
    sh:targetClass adp:DataProduct ;
    adp:level 2 ;
    adp:status "confirmed" .

