adp:R39_shape a sh:NodeShape ;
    rdfs:label "Lineage is a directed acyclic graph: a data product never depends on itself, directly or indirectly."@en ;
    dct:source "S26" ;
    sh:message "Lineage is a directed acyclic graph: a data product never depends on itself, directly or indirectly."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Lineage is a directed acyclic graph: a data product never depends on itself, directly or indirectly."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this WHERE { $this adp:dependsOn+ $this . }
""" ] ;
    sh:targetClass adp:DataProduct ;
    adp:level 2 ;
