adp:R29_shape a sh:NodeShape ;
    rdfs:label "A data product that depends on another data product is a child data product."@en ;
    dct:source "S24" ;
    sh:message "A data product that depends on another data product is a child data product."@en ;
    sh:rule [ a sh:TripleRule ;
            sh:condition [ a sh:PropertyShape ;
                    sh:minCount 1 ;
                    sh:path adp:dependsOn ] ;
            sh:object adp:ChildDataProduct ;
            sh:predicate rdf:type ;
            sh:subject sh:this ] ;
    sh:targetClass adp:DataProduct ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R2_shape a sh:NodeShape ;
    rdfs:label "The owner of a platform service is a platform team."@en ;
    dct:source "S3" ;
    sh:message "The owner of a platform service is a platform team."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The owner of a platform service is a platform team."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this WHERE { $this adp:ownedBy ?team . FILTER NOT EXISTS { ?team a adp:PlatformTeam } }
""" ] ;
    sh:targetClass adp:PlatformService ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:R30_shape a sh:NodeShape ;
    rdfs:label "A data product another data product depends on is a parent data product."@en ;
    dct:source "S24" ;
    sh:message "A data product another data product depends on is a parent data product."@en ;
    sh:rule [ a sh:TripleRule ;
            sh:condition [ a sh:PropertyShape ;
                    sh:minCount 1 ;
                    sh:path [ sh:inversePath adp:dependsOn ] ] ;
            sh:object adp:ParentDataProduct ;
            sh:predicate rdf:type ;
            sh:subject sh:this ] ;
    sh:targetClass adp:DataProduct ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R31_shape a sh:NodeShape ;
    rdfs:label "A data asset is always built by a data pipeline."@en ;
    dct:source "S24" ;
    sh:message "A data asset is always built by a data pipeline."@en ;
    sh:property adp:R31_shape_property ;
    sh:targetClass adp:DataAsset ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R32_shape a sh:NodeShape ;
    rdfs:label "A data pipeline populates only the data assets of its own data product."@en ;
    dct:source "S24" ;
    sh:message "A data pipeline populates only the data assets of its own data product."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A data pipeline populates only the data assets of its own data product."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this WHERE {
  $this adp:populates ?asset .
  FILTER NOT EXISTS { $this adp:belongsTo ?product . ?asset adp:belongsTo ?product . }
}
""" ] ;
    sh:targetClass adp:DataPipeline ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R33_shape a sh:NodeShape ;
    rdfs:label "A data pipeline reads only data assets of its own data product or of the parent data products of its data product."@en ;
    dct:source "S24",
        "S25" ;
    sh:message "A data pipeline reads only data assets of its own data product or of the parent data products of its data product."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A data pipeline reads only data assets of its own data product or of the parent data products of its data product."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this WHERE {
  $this adp:reads ?asset .
  FILTER NOT EXISTS {
    $this adp:belongsTo ?product .
    { ?asset adp:belongsTo ?product } UNION { ?product adp:dependsOn ?parent . ?asset adp:belongsTo ?parent }
  }
}
""" ] ;
    sh:targetClass adp:DataPipeline ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R34_shape a sh:NodeShape ;
    rdfs:label "The ingestion produces a data asset in the RAW layer."@en ;
    dct:source "S25" ;
    sh:message "The ingestion produces a data asset in the RAW layer."@en ;
    sh:or ( [ sh:not [ a sh:PropertyShape ;
                        sh:path [ sh:inversePath adp:populates ] ;
                        sh:qualifiedMinCount 1 ;
                        sh:qualifiedValueShape [ sh:class adp:IngestionDataPipeline ] ] ] [ a sh:PropertyShape ;
                sh:hasValue adp:RAW ;
                sh:path adp:inLayer ] ) ;
    sh:targetClass adp:DataAsset ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R35_shape a sh:NodeShape ;
    rdfs:label "A processing data pipeline populates only data assets in the CURATED or SERVING layer."@en ;
