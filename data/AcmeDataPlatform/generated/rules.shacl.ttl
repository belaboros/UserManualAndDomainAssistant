    rdfs:label "User principals consume only dashboards."@en ;
    dct:source "S33" ;
    sh:message "User principals consume only dashboards."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "User principals consume only dashboards."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this WHERE {
  $this adp:userConsumes ?used .
  ?used a ?kind . FILTER (?kind IN (adp:DataProduct, adp:MLModel, adp:AIModel, adp:AIAnalyticalApplication, adp:DataContract, adp:DataPipeline, adp:ComputeClusterDefinition, adp:WorkspaceInfraDefinition, adp:DataAsset))
}
""" ] ;
    sh:targetClass adp:UserPrincipal ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R4_shape a sh:NodeShape ;
    rdfs:label "Each platform resource is created by exactly one team."@en ;
    dct:source "S5" ;
    sh:message "Each platform resource is created by exactly one team."@en ;
    sh:property adp:R4_shape_property ;
    sh:targetClass adp:PlatformResource ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:R50_shape a sh:NodeShape ;
    rdfs:label "Service principals consume only data products, ML models and AI models."@en ;
    dct:source "S33" ;
    sh:message "Service principals consume only data products, ML models and AI models."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Service principals consume only data products, ML models and AI models."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this WHERE {
  $this adp:serviceConsumes ?used .
  FILTER NOT EXISTS { ?used a ?kind . FILTER (?kind IN (adp:DataProduct, adp:MLModel, adp:AIModel)) }
}
""" ] ;
    sh:targetClass adp:ServicePrincipal ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R52_shape a sh:NodeShape ;
    rdfs:label "An external application consumes only externally exposed/shared platform resources."@en ;
    dct:source "S35" ;
    sh:message "An external application consumes only externally exposed/shared platform resources."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "An external application consumes only externally exposed/shared platform resources."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this WHERE {
  $this adp:identityOf ?app . ?app a adp:ExternalApplication .
  $this adp:serviceConsumes ?resource .
  FILTER NOT EXISTS { ?resource adp:externallyShared true }
}
""" ] ;
    sh:targetClass adp:ServicePrincipal ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:R53_shape a sh:NodeShape ;
    rdfs:label "Each top-level platform resource (not a sub platform resource) has a product owner or data product owner."@en ;
    dct:source "S36",
        "S37",
        "S43" ;
    sh:message "Each top-level platform resource (not a sub platform resource) has a product owner or data product owner."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Each top-level platform resource (not a sub platform resource) has a product owner or data product owner."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this WHERE {
  FILTER NOT EXISTS { $this a adp:SubPlatformResource }
  FILTER NOT EXISTS { $this adp:hasProductOwner ?owner }
}
""" ] ;
    sh:targetClass adp:PlatformResource ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R54_shape a sh:NodeShape ;
    rdfs:label "Each top-level platform resource has at most one product owner; with R53: exactly one."@en ;
    dct:source "S43" ;
    sh:message "Each top-level platform resource has at most one product owner; with R53: exactly one."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Each top-level platform resource has at most one product owner; with R53: exactly one."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this WHERE {
  FILTER NOT EXISTS { $this a adp:SubPlatformResource }
  $this adp:hasProductOwner ?first, ?second .
  FILTER (?first != ?second)
}
""" ] ;
    sh:targetClass adp:PlatformResource ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R55_shape a sh:NodeShape ;
    rdfs:label "The product owner of a data product is a data product owner."@en ;
    dct:source "S36" ;
    sh:message "The product owner of a data product is a data product owner."@en ;
    sh:property adp:R55_shape_property ;
    sh:targetClass adp:DataProduct ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R56_shape a sh:NodeShape ;
    rdfs:label "The product owner of a platform resource is a member of the owner product team."@en ;
    dct:source "S36",
        "S37" ;
    sh:message "The product owner of a platform resource is a member of the owner product team."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The product owner of a platform resource is a member of the owner product team."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this WHERE {
  $this adp:hasProductOwner ?owner ; adp:resourceOwnedBy ?team .
  FILTER NOT EXISTS { ?owner adp:memberOf ?team }
}
""" ] ;
    sh:targetClass adp:PlatformResource ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R57_shape a sh:NodeShape ;
    rdfs:label "A subscription request is created by exactly one product owner."@en ;
    dct:source "S40" ;
    sh:message "A subscription request is created by exactly one product owner."@en ;
    sh:property adp:R57_shape_property ;
    sh:targetClass adp:SubscriptionRequest ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R58_shape a sh:NodeShape ;
    rdfs:label "A subscription request is for exactly one existing platform resource."@en ;
    dct:source "S40" ;
    sh:message "A subscription request is for exactly one existing platform resource."@en ;
    sh:property adp:R58_shape_property ;
    sh:targetClass adp:SubscriptionRequest ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R59_shape a sh:NodeShape ;
    rdfs:label "A subscription request names exactly one consumer: the new platform resource or the other application."@en ;
    dct:source "S40",
        "S42" ;
    sh:message "A subscription request names exactly one consumer: the new platform resource or the other application."@en ;
    sh:property adp:R59_shape_property ;
    sh:targetClass adp:SubscriptionRequest ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R5_shape a sh:NodeShape ;
    rdfs:label "A platform resource is created by a product team, never by a platform team."@en ;
    dct:source "S4",
        "S5" ;
    sh:message "A platform resource is created by a product team, never by a platform team."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A platform resource is created by a product team, never by a platform team."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this WHERE { $this adp:createdBy ?team . ?team a adp:PlatformTeam . }
""" ] ;
    sh:targetClass adp:PlatformResource ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:R60_shape a sh:NodeShape ;
    rdfs:label "A subscription request for a new data product, application or other platform resource is created by its owner."@en ;
    dct:source "S40",
        "S45" ;
    sh:message "A subscription request for a new data product, application or other platform resource is created by its owner."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A subscription request for a new data product, application or other platform resource is created by its owner."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this WHERE {
  $this adp:requestedBy ?requester ; adp:requestConsumer ?consumer .
  ?consumer a adp:PlatformResource .
  FILTER NOT EXISTS { ?consumer adp:hasProductOwner ?requester }
}
""" ] ;
    sh:targetClass adp:SubscriptionRequest ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R61_shape a sh:NodeShape ;
    rdfs:label "The product owner of the subscribed platform resource receives the subscription request."@en ;
    dct:source "S41" ;
    sh:message "The product owner of the subscribed platform resource receives the subscription request."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The product owner of the subscribed platform resource receives the subscription request."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this ?value WHERE {
  { $this adp:receivedBy ?value . FILTER NOT EXISTS { $this adp:requestFor/adp:hasProductOwner ?value } }
  UNION { $this adp:requestFor/adp:hasProductOwner ?value . FILTER NOT EXISTS { $this adp:receivedBy ?value } }
}""" ] ;
    sh:targetClass adp:SubscriptionRequest ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R62_shape a sh:NodeShape ;
    rdfs:label "A subscription request is pending, approved or rejected."@en ;
    dct:source "S41" ;
    sh:message "A subscription request is pending, approved or rejected."@en ;
    sh:property adp:R62_shape_property ;
    sh:targetClass adp:SubscriptionRequest ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R63_shape a sh:NodeShape ;
    rdfs:label "After approval the subscribed platform resource is accessible for the consumer application and its owner team."@en ;
    dct:source "S42" ;
    sh:message "After approval the subscribed platform resource is accessible for the consumer application and its owner team."@en ;
    sh:rule [ a sh:SPARQLRule ;
            sh:construct """CONSTRUCT { ?consumer adp:hasAccessTo ?resource . ?team adp:subscribesTo ?resource . }
WHERE {
  $this adp:hasStatus adp:Approved ; adp:requestFor ?resource ; adp:requestConsumer ?consumer .
  OPTIONAL { ?consumer adp:resourceOwnedBy ?team }
}
""" ;
            sh:prefixes adp:_prefixes ] ;
    sh:targetClass adp:SubscriptionRequest ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R64_shape a sh:NodeShape ;
    rdfs:label "A platform resource consumes another platform resource only after an approved subscription request, also when both are created by the same product team."@en ;
    dct:source "S39",
        "S42",
        "S44",
        "S46",
        "S47" ;
    sh:message "A platform resource consumes another platform resource only after an approved subscription request, also when both are created by the same product team."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A platform resource consumes another platform resource only after an approved subscription request, also when both are created by the same product team."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this WHERE {
  $this adp:consumes ?resource .
  FILTER NOT EXISTS { $this adp:hasAccessTo ?resource }
}
""" ] ;
    sh:targetClass adp:PlatformResource ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R65_shape a sh:NodeShape ;
    rdfs:label "An application (internal or external) consumes a platform resource only after an approved subscription request, also when it is created by the same product team."@en ;
    dct:source "S39",
        "S44",
        "S46",
        "S47" ;
    sh:message "An application (internal or external) consumes a platform resource only after an approved subscription request, also when it is created by the same product team."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "An application (internal or external) consumes a platform resource only after an approved subscription request, also when it is created by the same product team."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this WHERE {
  $this adp:serviceConsumes ?resource .
  FILTER NOT EXISTS { $this adp:identityOf ?app . ?app adp:hasAccessTo ?resource . }
}
""" ] ;
    sh:targetClass adp:ServicePrincipal ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:R66_shape a sh:NodeShape ;
    rdfs:label "Each external application has exactly one product owner."@en ;
    dct:source "S48" ;
    sh:message "Each external application has exactly one product owner."@en ;
    sh:property adp:R66_shape_property ;
    sh:targetClass adp:ExternalApplication ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:R67_shape a sh:NodeShape ;
    rdfs:label "A subscription request for an external application is created by its product owner."@en ;
    dct:source "S48" ;
    sh:message "A subscription request for an external application is created by its product owner."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A subscription request for an external application is created by its product owner."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this WHERE {
  $this adp:requestedBy ?requester ; adp:requestConsumer ?app .
  ?app a adp:ExternalApplication .
  FILTER NOT EXISTS { ?app adp:externalAppOwner ?requester }
}
""" ] ;
    sh:targetClass adp:SubscriptionRequest ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:R68_shape a sh:NodeShape ;
    rdfs:label "By default a platform resource is exposed (automatically) in the catalog of each environment it is in, unless exposure is turned off."@en ;
    dct:source "S38",
        "S49" ;
    sh:message "By default a platform resource is exposed (automatically) in the catalog of each environment it is in, unless exposure is turned off."@en ;
    sh:rule [ a sh:SPARQLRule ;
            sh:construct """CONSTRUCT { $this adp:exposedIn ?catalog . }
WHERE {
  $this adp:createdIn|adp:promotedTo ?environment .
  ?catalog adp:catalogOf ?environment .
  FILTER NOT EXISTS { $this adp:exposedInCatalog false }
}
""" ;
            sh:prefixes adp:_prefixes ] ;
    sh:targetClass adp:PlatformResource ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R69_shape a sh:NodeShape ;
    rdfs:label "Each employee has exactly one user principal."@en ;
    dct:source "S50" ;
    sh:message "Each employee has exactly one user principal."@en ;
    sh:property adp:R69_shape_property ;
    sh:targetClass adp:Employee ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R6_shape a sh:NodeShape ;
    rdfs:label "A platform resource is owned by the product team which created it."@en ;
    dct:source "S5" ;
    sh:message "A platform resource is owned by the product team which created it."@en ;
    sh:property adp:R6_shape_property ;
    sh:targetClass adp:PlatformResource ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:R70_shape a sh:NodeShape ;
    rdfs:label "After approval the team members included in a subscription request get access to the subscribed platform resource as well."@en ;
    dct:source "S51" ;
    sh:message "After approval the team members included in a subscription request get access to the subscribed platform resource as well."@en ;
    sh:rule [ a sh:SPARQLRule ;
            sh:construct """CONSTRUCT { ?user adp:hasAccessTo ?resource . }
WHERE {
  $this adp:hasStatus adp:Approved ; adp:requestFor ?resource ; adp:includesMember ?member .
  ?member adp:hasUserPrincipal ?user .
}
""" ;
            sh:prefixes adp:_prefixes ] ;
    sh:targetClass adp:SubscriptionRequest ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R71_shape a sh:NodeShape ;
    rdfs:label "The members included in a subscription request are members of the consumer's owner team."@en ;
    dct:source "S51" ;
    sh:message "The members included in a subscription request are members of the consumer's owner team."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The members included in a subscription request are members of the consumer's owner team."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this WHERE {
  $this adp:includesMember ?member ; adp:requestConsumer ?consumer .
  ?consumer adp:resourceOwnedBy ?team .
  FILTER NOT EXISTS { ?member adp:memberOf ?team }
}
""" ] ;
    sh:targetClass adp:SubscriptionRequest ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R72_shape a sh:NodeShape ;
    rdfs:label "A user principal consumes a platform resource of another team only after being included in an approved subscription request."@en ;
    dct:source "S51",
        "S55" ;
    sh:message "A user principal consumes a platform resource of another team only after being included in an approved subscription request."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A user principal consumes a platform resource of another team only after being included in an approved subscription request."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this WHERE {
  $this adp:userConsumes ?resource .
  ?resource adp:resourceOwnedBy ?team .
  FILTER NOT EXISTS { ?member adp:hasUserPrincipal $this ; adp:memberOf ?team . }
  FILTER NOT EXISTS { $this adp:hasAccessTo ?resource }
}
""" ] ;
    sh:targetClass adp:UserPrincipal ;
    adp:level 2 ;
    adp:status "confirmed" .

adp:R73_shape a sh:NodeShape ;
    rdfs:label "An elevated permission is time-limited: it has exactly one end time."@en ;
    dct:source "S53" ;
    sh:message "An elevated permission is time-limited: it has exactly one end time."@en ;
    sh:property adp:R73_shape_property ;
    sh:targetClass adp:ElevatedPermission ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:R74_shape a sh:NodeShape ;
    rdfs:label "An elevated permission is for incident resolution or debugging."@en ;
    dct:source "S53" ;
    sh:message "An elevated permission is for incident resolution or debugging."@en ;
    sh:property adp:R74_shape_property ;
    sh:targetClass adp:ElevatedPermission ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:R75_shape a sh:NodeShape ;
    rdfs:label "An elevated permission covers only tables/views in the developer's own data product or in the parent data products."@en ;
    dct:source "S53" ;
    sh:message "An elevated permission covers only tables/views in the developer's own data product or in the parent data products."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "An elevated permission covers only tables/views in the developer's own data product or in the parent data products."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this WHERE {
  $this adp:grantedTo ?user ; adp:permissionOn ?asset .
  FILTER NOT EXISTS {
    ?developer adp:hasUserPrincipal ?user ; adp:developerOf ?resource .
    { ?asset adp:belongsTo ?resource } UNION { ?resource adp:consumes ?parent . ?asset adp:belongsTo ?parent }
  }
}
""" ] ;
    sh:targetClass adp:ElevatedPermission ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:R77_shape a sh:NodeShape ;
    rdfs:label "An access restriction is set by the product owner of the restricted platform resource."@en ;
    dct:source "S55",
        "S56" ;
    sh:message "An access restriction is set by the product owner of the restricted platform resource."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "An access restriction is set by the product owner of the restricted platform resource."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this ?value WHERE {
  { $this adp:setBy ?value . FILTER NOT EXISTS { $this adp:restricts/adp:hasProductOwner ?value } }
  UNION { $this adp:restricts/adp:hasProductOwner ?value . FILTER NOT EXISTS { $this adp:setBy ?value } }
}""" ] ;
    sh:targetClass adp:AccessRestriction ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:R78_shape a sh:NodeShape ;
    rdfs:label "In an environment where the product owner restricted a platform resource, users get only elevated permissions on its tables/views."@en ;
    dct:source "S53",
        "S55" ;
    sh:message "In an environment where the product owner restricted a platform resource, users get only elevated permissions on its tables/views."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "In an environment where the product owner restricted a platform resource, users get only elevated permissions on its tables/views."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this WHERE {
  $this adp:inEnvironment ?environment ; adp:permissionOn ?asset .
  ?asset adp:belongsTo ?resource .
  ?restriction adp:restricts ?resource ; adp:restrictedIn ?environment .
  FILTER NOT EXISTS { $this a adp:ElevatedPermission }
}
""" ] ;
    sh:targetClass adp:Permission ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:R79_shape a sh:NodeShape ;
    rdfs:label "In an environment where the product owner restricted a dashboard (or the platform resource it belongs to), users get only elevated permissions to view it."@en ;
    dct:source "S55",
        "S57" ;
    sh:message "In an environment where the product owner restricted a dashboard (or the platform resource it belongs to), users get only elevated permissions to view it."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "In an environment where the product owner restricted a dashboard (or the platform resource it belongs to), users get only elevated permissions to view it."@en ;
            sh:prefixes adp:_prefixes ;
            sh:select """SELECT $this WHERE {
  $this adp:inEnvironment ?environment ; adp:viewPermissionOn ?dashboard .
  { ?restriction adp:restricts ?dashboard } UNION { ?dashboard adp:belongsTo ?resource . ?restriction adp:restricts ?resource }
  ?restriction adp:restrictedIn ?environment .
  FILTER NOT EXISTS { $this a adp:ElevatedPermission }
}
""" ] ;
    sh:targetClass adp:Permission ;
    adp:level 3 ;
    adp:status "confirmed" .

adp:R7_shape a sh:NodeShape ;
    rdfs:label "A platform resource is created in exactly one environment."@en ;
    dct:source "S11",
        "S7" ;
    sh:message "A platform resource is created in exactly one environment."@en ;
    sh:property adp:R7_shape_property ;
    sh:targetClass adp:PlatformResource ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:R8_shape a sh:NodeShape ;
    rdfs:label "A platform resource is created in the EXP or in the DEV environment."@en ;
    dct:source "S11",
        "S13",
        "S7" ;
    sh:message "A platform resource is created in the EXP or in the DEV environment."@en ;
    sh:property adp:R8_shape_property ;
    sh:targetClass adp:PlatformResource ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:R9_shape a sh:NodeShape ;
    rdfs:label "A platform resource can only be promoted to DEV, ACC or PRD."@en ;
    dct:source "S11",
        "S12",
        "S8" ;
    sh:message "A platform resource can only be promoted to DEV, ACC or PRD."@en ;
    sh:property adp:R9_shape_property ;
    sh:targetClass adp:PlatformResource ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:R13_shape_property a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:message "A sub platform resource belongs to exactly one parent platform resource; it cannot live on its own."@en ;
    sh:minCount 1 ;
    sh:path adp:belongsTo .

adp:R18_shape_property a sh:PropertyShape ;
    sh:message "A data product consists of a contract."@en ;
    sh:path [ sh:inversePath adp:belongsTo ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [ sh:class adp:DataContract ] .

adp:R19_shape_property a sh:PropertyShape ;
    sh:message "A data product consists of a data pipeline."@en ;
    sh:path [ sh:inversePath adp:belongsTo ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [ sh:class adp:DataPipeline ] .

adp:R1_shape_property a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:message "Each platform service is owned by exactly one team."@en ;
    sh:minCount 1 ;
    sh:path adp:ownedBy .

adp:R20_shape_property a sh:PropertyShape ;
    sh:message "A data product consists of a compute cluster definition."@en ;
    sh:path [ sh:inversePath adp:belongsTo ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [ sh:class adp:ComputeClusterDefinition ] .

adp:R21_shape_property a sh:PropertyShape ;
    sh:message "A data product consists of a workspace infra definition."@en ;
    sh:path [ sh:inversePath adp:belongsTo ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [ sh:class adp:WorkspaceInfraDefinition ] .

adp:R22_shape_property a sh:PropertyShape ;
    sh:message "A data product consists of at least one data asset."@en ;
    sh:path [ sh:inversePath adp:belongsTo ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [ sh:class adp:DataAsset ] .

adp:R23_shape_property a sh:PropertyShape ;
    sh:message "A data product consists of at least one dashboard showing its health."@en ;
    sh:path [ sh:inversePath adp:belongsTo ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [ sh:class adp:Dashboard ] .

adp:R31_shape_property a sh:PropertyShape ;
    sh:message "A data asset is always built by a data pipeline."@en ;
    sh:minCount 1 ;
    sh:path [ sh:inversePath adp:populates ] .

adp:R35_shape_property a sh:PropertyShape ;
    sh:in ( adp:CURATED adp:SERVING ) ;
    sh:message "A processing data pipeline populates only data assets in the CURATED or SERVING layer."@en ;
    sh:path ( adp:populates adp:inLayer ) .

adp:R36_shape_property a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:message "Each data asset is in exactly one medallion layer."@en ;
    sh:minCount 1 ;
    sh:path adp:inLayer .

adp:R37_shape_property a sh:PropertyShape ;
    sh:message "An ingestion data pipeline ingests data from at least one source service or data source."@en ;
    sh:minCount 1 ;
    sh:path adp:ingestsFrom .

adp:R3_shape_property a sh:PropertyShape ;
    sh:message "Each (top-level or nested) platform resource is created with one or more platform services."@en ;
    sh:minCount 1 ;
    sh:path adp:createdWith .

adp:R44_shape_property a sh:PropertyShape ;
    sh:equals adp:dependsOn ;
    sh:message "The data products a data product consumes are its parent (upstream) data products."@en ;
    sh:path adp:consumes .

adp:R46_shape_property a sh:PropertyShape ;
    sh:maxCount 0 ;
    sh:message "An ingestion data pipeline does not transform data: it reads no data assets."@en ;
    sh:path adp:reads .

adp:R47_shape_property a sh:PropertyShape ;
    sh:maxCount 0 ;
    sh:message "A processing data pipeline is not allowed to ingest."@en ;
    sh:path adp:ingestsFrom .

adp:R4_shape_property a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:message "Each platform resource is created by exactly one team."@en ;
    sh:minCount 1 ;
    sh:path adp:createdBy .

adp:R55_shape_property a sh:PropertyShape ;
    sh:class adp:DataProductOwner ;
    sh:message "The product owner of a data product is a data product owner."@en ;
    sh:path adp:hasProductOwner .

adp:R57_shape_property a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:message "A subscription request is created by exactly one product owner."@en ;
    sh:minCount 1 ;
    sh:path adp:requestedBy .

adp:R58_shape_property a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:message "A subscription request is for exactly one existing platform resource."@en ;
    sh:minCount 1 ;
    sh:path adp:requestFor .

adp:R59_shape_property a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:message "A subscription request names exactly one consumer: the new platform resource or the other application."@en ;
    sh:minCount 1 ;
    sh:path adp:requestConsumer .

adp:R62_shape_property a sh:PropertyShape ;
    sh:in ( adp:Pending adp:Approved adp:Rejected ) ;
    sh:message "A subscription request is pending, approved or rejected."@en ;
    sh:path adp:hasStatus .

adp:R66_shape_property a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:message "Each external application has exactly one product owner."@en ;
    sh:minCount 1 ;
    sh:path adp:externalAppOwner .

adp:R69_shape_property a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:message "Each employee has exactly one user principal."@en ;
    sh:minCount 1 ;
    sh:path adp:hasUserPrincipal .

adp:R6_shape_property a sh:PropertyShape ;
    sh:equals adp:createdBy ;
    sh:message "A platform resource is owned by the product team which created it."@en ;
    sh:path adp:ownedBy .

adp:R73_shape_property a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:message "An elevated permission is time-limited: it has exactly one end time."@en ;
    sh:minCount 1 ;
    sh:path adp:validUntil .

adp:R74_shape_property a sh:PropertyShape ;
    sh:in ( adp:IncidentResolution adp:Debugging ) ;
    sh:message "An elevated permission is for incident resolution or debugging."@en ;
    sh:path adp:forPurpose .

adp:R7_shape_property a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:message "A platform resource is created in exactly one environment."@en ;
    sh:minCount 1 ;
    sh:path adp:createdIn .

adp:R8_shape_property a sh:PropertyShape ;
    sh:in ( adp:EXP adp:DEV ) ;
    sh:message "A platform resource is created in the EXP or in the DEV environment."@en ;
    sh:path adp:createdIn .

adp:R9_shape_property a sh:PropertyShape ;
    sh:in ( adp:DEV adp:ACC adp:PRD ) ;
    sh:message "A platform resource can only be promoted to DEV, ACC or PRD."@en ;
    sh:path adp:promotedTo .

adp:_prefixes a owl:Ontology ;
    sh:declare [ sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ;
            sh:prefix "rdf" ],
        [ sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ;
            sh:prefix "rdfs" ],
        [ sh:namespace "https://example.org/acme/data-platform#"^^xsd:anyURI ;
            sh:prefix "adp" ],
        [ sh:namespace "http://www.w3.org/2002/07/owl#"^^xsd:anyURI ;
            sh:prefix "owl" ],
        [ sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ;
            sh:prefix "xsd" ] .

