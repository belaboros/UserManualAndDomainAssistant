    skos:topConceptOf adp:_isAScheme ;
    adp:level 1 ;
    adp:status "confirmed" .

adp:_isAScheme a skos:ConceptScheme ;
    skos:hasTopConcept adp:AccessRestriction,
        adp:Budget,
        adp:BudgetAdjustmentRequest,
        adp:BusinessCase,
        adp:Catalog,
        adp:DataPlatform,
        adp:DataQualityRule,
        adp:DataSource,
        adp:Department,
        adp:Employee,
        adp:Environment,
        adp:ExternalApplication,
        adp:Feedback,
        adp:GateSeverity,
        adp:Incident,
        adp:ManualReview,
        adp:MedallionLayer,
        adp:Permission,
        adp:PlatformResource,
        adp:PlatformService,
        adp:Principal,
        adp:Privilege,
        adp:Productionization,
        adp:Promotion,
        adp:ProofOfConcept,
        adp:Purpose,
        adp:QualityGate,
        adp:QualityGateResult,
        adp:ResourceLimitation,
        adp:ServiceLevelIndicator,
        adp:ServiceLevelObjective,
        adp:SubscriptionRequest,
        adp:SubscriptionStatus,
        adp:Team,
        adp:Tool,
        adp:VersionUpgrade ;
    skos:prefLabel "AcmeDataPlatform concepts (is-a)"@en .

