# Generated by domain-model from the rules in ontology.yaml. Do not edit.

@prefix dct: <http://purl.org/dc/terms/> .
@prefix lib: <https://example.org/library#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lib:R1_shape a sh:NodeShape ;
    rdfs:label "A loan has between 1 and 5 items."@en ;
    dct:source "S2" ;
    sh:message "A loan has between 1 and 5 items."@en ;
    sh:property lib:R1_shape_property ;
    sh:targetClass lib:Loan ;
    lib:level 1 ;
    lib:status "confirmed" .

lib:R2_shape a sh:NodeShape ;
    rdfs:label "The status of a loan is active or returned."@en ;
    dct:source "S3" ;
    sh:message "The status of a loan is active or returned."@en ;
    sh:property lib:R2_shape_property ;
    sh:targetClass lib:Loan ;
    lib:level 2 ;
    lib:status "confirmed" .

lib:R3_shape a sh:NodeShape ;
    rdfs:label "A returned loan has a return date."@en ;
    dct:source "S3" ;
    sh:message "A returned loan has a return date."@en ;
    sh:or ( [ sh:not [ a sh:PropertyShape ;
                        sh:hasValue lib:Returned ;
                        sh:path lib:hasStatus ] ] [ a sh:PropertyShape ;
                sh:minCount 1 ;
                sh:path lib:returnedOn ] ) ;
    sh:targetClass lib:Loan ;
    lib:level 2 ;
    lib:status "confirmed" .

lib:R4_shape a sh:NodeShape ;
    rdfs:label "The borrower of a loan is the member recorded as its borrower."@en ;
    dct:source "S1" ;
    sh:message "The borrower of a loan is the member recorded as its borrower."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The borrower of a loan is the member recorded as its borrower."@en ;
            sh:prefixes lib:_prefixes ;
            sh:select """SELECT $this ?value WHERE {
  { $this lib:hasBorrower ?value . FILTER NOT EXISTS { $this ^lib:borrowerOf ?value } }
  UNION { $this ^lib:borrowerOf ?value . FILTER NOT EXISTS { $this lib:hasBorrower ?value } }
}""" ] ;
    sh:targetClass lib:Loan ;
    lib:level 2 ;
    lib:status "draft" .

lib:R5_shape a sh:NodeShape ;
    rdfs:label "An active loan is an open loan."@en ;
    dct:source "S3" ;
    sh:message "An active loan is an open loan."@en ;
    sh:rule [ a sh:TripleRule ;
            sh:condition [ a sh:PropertyShape ;
                    sh:hasValue lib:Active ;
                    sh:path lib:hasStatus ] ;
            sh:object lib:OpenLoan ;
            sh:predicate rdf:type ;
            sh:subject sh:this ] ;
    sh:targetClass lib:Loan ;
    lib:level 2 ;
    lib:status "confirmed" .

lib:R6_shape a sh:NodeShape ;
    rdfs:label "A loan is served by the branches where its items are located."@en ;
    dct:source "S4" ;
    sh:message "A loan is served by the branches where its items are located."@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object [ sh:path ( lib:hasItem lib:locatedIn ) ] ;
            sh:predicate lib:servedBy ;
            sh:subject sh:this ] ;
    sh:targetClass lib:Loan ;
    lib:level 3 ;
    lib:status "confirmed" .

lib:R7_shape a sh:NodeShape ;
    rdfs:label "The due date of a loan is after its start date."@en ;
    dct:source "S2" ;
    sh:message "The due date of a loan is after its start date."@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The due date of a loan is after its start date."@en ;
            sh:prefixes lib:_prefixes ;
            sh:select """SELECT $this WHERE {
  $this lib:startDate ?start ; lib:dueDate ?due .
  FILTER (?due <= ?start)
}
""" ] ;
    sh:targetClass lib:Loan ;
    lib:level 1 ;
    lib:status "confirmed" .

lib:R8_shape a sh:NodeShape ;
    rdfs:label "A loan returned after its due date is a late loan."@en ;
    dct:source "S4" ;
    sh:message "A loan returned after its due date is a late loan."@en ;
    sh:rule [ a sh:SPARQLRule ;
            sh:construct """CONSTRUCT { $this a lib:LateLoan . } WHERE {
  $this lib:returnedOn ?returned ; lib:dueDate ?due .
  FILTER (?returned > ?due)
}
""" ;
            sh:prefixes lib:_prefixes ] ;
    sh:targetClass lib:Loan ;
    lib:level 3 ;
    lib:status "confirmed" .

lib:R1_shape_property a sh:PropertyShape ;
    sh:maxCount 5 ;
    sh:message "A loan has between 1 and 5 items."@en ;
    sh:minCount 1 ;
    sh:path lib:hasItem .

lib:R2_shape_property a sh:PropertyShape ;
    sh:in ( lib:Active lib:Returned ) ;
    sh:message "The status of a loan is active or returned."@en ;
    sh:path lib:hasStatus .

lib:_prefixes a owl:Ontology ;
    sh:declare [ sh:namespace "http://www.w3.org/2002/07/owl#"^^xsd:anyURI ;
            sh:prefix "owl" ],
        [ sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ;
            sh:prefix "xsd" ],
        [ sh:namespace "https://example.org/library#"^^xsd:anyURI ;
            sh:prefix "lib" ],
        [ sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ;
            sh:prefix "rdf" ],
        [ sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ;
            sh:prefix "rdfs" ] .

