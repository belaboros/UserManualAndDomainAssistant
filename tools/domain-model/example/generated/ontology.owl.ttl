dcterms:source a owl:AnnotationProperty .

skos:altLabel a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

<https://example.org/library> a owl:Ontology ;
    rdfs:label "Library lending ontology"@en .

lib:Active a owl:NamedIndividual,
        lib:LoanStatus ;
    rdfs:label "active"@en ;
    dcterms:source "S3" ;
    lib:level 2 ;
    lib:status "confirmed" .

lib:AudioVisualItem a owl:Class ;
    rdfs:label "audio/visual \"AV\" item"@en ;
    dcterms:source "S2" ;
    rdfs:subClassOf lib:Item ;
    owl:disjointWith lib:Book ;
    skos:definition "A recording on a physical carrier."@en ;
