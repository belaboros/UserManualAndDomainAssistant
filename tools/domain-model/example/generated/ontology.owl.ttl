    skos:altLabel "Hobbit"@en ;
    skos:definition "A sample book."@en ;
    lib:isReference false ;
    lib:level 3 ;
    lib:locatedIn lib:CentralBranch ;
    lib:pageCount 310 ;
    lib:status "draft" ;
    lib:title "The Hobbit" .

lib:LateLoan a owl:Class ;
    rdfs:label "late loan"@en ;
    dcterms:source "S4" ;
    rdfs:subClassOf lib:Loan ;
    skos:definition "A loan returned after its due date (derived by rule R8)."@en ;
    lib:level 3 ;
    lib:status "confirmed" .

lib:OpenLoan a owl:Class ;
    rdfs:label "open loan"@en ;
    dcterms:source "S3" ;
