    lib:status "confirmed" .

lib:Branch a owl:Class ;
    rdfs:label "branch"@en ;
    dcterms:source "S3" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass lib:Shelf ;
