    lib:status "confirmed" .

lib:Shelf a owl:Class ;
    rdfs:label "shelf"@en ;
    dcterms:source "S4" ;
    lib:level 3 ;
    lib:status "confirmed" .

lib:Book a owl:Class ;
    rdfs:label "book"@en ;
    dcterms:source "S2" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
